# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Test/coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Synthetic data output (regenerated locally)
tests/fixtures/output/

# Data files — avoid leaking sensitive real-world data
# Visual FoxPro / DBF source files
*.dbf
*.dbf.*
*.fpt
*.cdx
*.ndx
*.mdx
# Export formats (output of conversion)
*.csv
*.json
*.jsonl
*.xlsx
benchmark-data/
benchmarks/results/
# Accepted benchmark baselines are intentional, versioned evidence.
!benchmarks/baselines/*.json
!benchmarks/regression/*.json
# Schema/metadata/report files (generated)
*.schema.jsonl
*.metadata.json
migration_report.*
verification_report.*
# Exception: keep test fixture scripts and .gitkeep files
!tests/fixtures/**/generate_sample_dbf.py
!**/.gitkeep
# Exception: keep examples README
!examples/README.md
