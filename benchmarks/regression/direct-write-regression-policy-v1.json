  "derivation": "center = median(values); mad = median(|v - center|); envelope_upper = max(center + max(mad_multiplier*mad, max_observed_deviation), max(values)*small_sample_guard_band); hard_gate iff envelope_upper <= center * hard_gate_discrimination_bound",
