    "W5/W1 wall-seconds-per-record"
  ],
  "parameters": {
    "hard_gate_discrimination_bound": {
      "kind": "engineering_policy_parameter",
      "rationale": "A ratio is hard-gated only when its envelope stays within 50 percent of the calibrated center; beyond that the policy could not distinguish a genuine regression from calibration noise.",
      "value": 1.5
    },
    "mad_multiplier": {
      "kind": "engineering_policy_parameter",
      "rationale": "Standard 3-MAD dispersion envelope from the repository's proven Phase 3 regression methodology; captures expected run-to-run variance without following hosted-runner outliers.",
      "value": 3.0
    },
    "small_sample_guard_band": {
      "kind": "engineering_policy_parameter",
      "rationale": "Small-sample tail guard: five calibration samples cannot bound the true distribution tail, so the envelope additionally covers 15 percent above the maximum observed value.",
      "value": 1.15
    }
  },
